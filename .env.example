# AWS API Gateway Base URL for Multi-Tenant MySQL Provisioning Service
# Format: https://{restApiId}.execute-api.{region}.amazonaws.com/{stage}
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com/Prod

# Deployment region and environment indicator
VITE_AWS_REGION=ap-south-1
VITE_ENVIRONMENT=dev

# Optional: Set to true ONLY for offline local UI testing without AWS credentials. Default is false (real AWS APIs).
VITE_USE_MOCK_DATA=false
